{
  "name": "ammar-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n tw,next \"npm:tw:watch\" \"next dev\"",
    "tw": "tailwindcss -i src/app/tailwind.css -o src/app/tw.generated.css --minify",
    "tw:watch": "tailwindcss -i src/app/tailwind.css -o src/app/tw.generated.css --watch",
    "prebuild": "npm run bake:sets && npm run tw",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "bake:sets": "node scripts/bake-terminal-sets.cjs"
  },
  "dependencies": {
    "@vercel/analytics": "^1.6.1",
    "framer-motion": "^12.29.2",
    "next": "^16.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
